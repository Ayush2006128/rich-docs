<% content_for :title, "Docs" %>

<div class="mx-auto max-w-4xl px-6 py-12">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold tracking-tight">Your docs</h1>
    <%= link_to "New doc", new_doc_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
  </div>

  <div id="docs" class="mt-8 grid gap-4">
    <% @docs.each do |doc| %>
      <div class="rounded-lg p-5 ring-1 ring-slate-200 transition hover:bg-slate-50 hover:ring-slate-300">
        <%= link_to doc.title.presence || "Untitled document", doc, class: "text-xl font-semibold text-slate-900 hover:underline" %>
        <p class="mt-1 text-xs text-slate-500">Updated <%= time_ago_in_words doc.updated_at %> ago</p>
      </div>
    <% end %>

    <% if @docs.empty? %>
      <p class="rounded-lg border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500">
        No documents yet. <%= link_to "Create your first one", new_doc_path, class: "font-semibold text-blue-600 hover:underline" %>.
      </p>
    <% end %>
  </div>
</div>
