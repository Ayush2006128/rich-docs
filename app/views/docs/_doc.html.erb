<div id="<%= dom_id doc %>">
  <h2 class="text-xl font-semibold text-slate-900"><%= doc.title.presence || "Untitled document" %></h2>
  <p class="mt-1 text-xs text-slate-500">Updated <%= time_ago_in_words doc.updated_at %> ago</p>

  <div class="prose prose-slate mt-4 max-w-none">
    <%= doc.content %>
  </div>
</div>
