<% content_for :title, "Editing doc" %>

<div class="mx-auto max-w-3xl px-6 py-12">
  <h1 class="text-3xl font-bold tracking-tight">Editing doc</h1>

  <%= render "form", doc: @doc %>

  <div class="mt-6 flex gap-4 text-sm">
    <%= link_to "Show this doc", @doc, class: "text-slate-600 hover:text-slate-900" %>
    <%= link_to "Back to docs", docs_path, class: "text-slate-600 hover:text-slate-900" %>
  </div>
</div>
