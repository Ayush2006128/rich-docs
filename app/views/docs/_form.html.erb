<%= form_with(model: doc, class: "mt-8 space-y-6") do |form| %>
  <% if doc.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-800 ring-1 ring-red-200">
      <h2 class="font-semibold"><%= pluralize(doc.errors.count, "error") %> prohibited this doc from being saved:</h2>

      <ul class="mt-2 list-inside list-disc">
        <% doc.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :title, placeholder: "Untitled document", class: "mt-2 block w-full rounded-md border-0 px-3 py-2 text-slate-900 ring-1 ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-600" %>
  </div>

  <div>
    <%= form.label :content, class: "block text-sm font-medium text-slate-700" %>
    <%= form.rich_text_area :content, class: "mt-2 block w-full rounded-md bg-white px-3 py-2 ring-1 ring-slate-300 focus:ring-2 focus:ring-blue-600" %>
  </div>

  <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" %>
<% end %>
